{
  "name": "uri-resolver",
  "version": "1.0.0",
  "description": "离线 URI 相对引用解析与路径合并解释后端（RFC 3986 第五节）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "uri-resolve": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-sqlite --import tsx --test src/**/*.test.ts",
    "start": "node --experimental-sqlite dist/server.js",
    "dev": "node --experimental-sqlite --import tsx src/server.ts",
    "demo": "node --experimental-sqlite --import tsx src/demo.ts",
    "cli": "node --experimental-sqlite --import tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
